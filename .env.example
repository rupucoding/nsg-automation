# Copy to .env and fill in. .env is git-ignored - NEVER commit it.

# Subscription to manage (can also be passed with --subscription or set in the JSON config).
AZURE_SUBSCRIPTION_ID=

# ---- Optional: service principal authentication (CI/CD, automation accounts) ----
# Leave empty to use `az login`, managed identity or VS Code sign-in instead.
# DefaultAzureCredential reads these directly; the tool never logs them.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_CLIENT_CERTIFICATE_PATH=

# ---- Optional: user-assigned managed identity ----
# AZURE_CLIENT_ID=<client id of the user-assigned identity>

# ---- Tool settings ----
NSG_TOOL_LOG_DIR=logs
NSG_TOOL_LOG_LEVEL=INFO
# NSG_TOOL_AUDIT_LOG=logs/audit.log
